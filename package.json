{
  "name": "golau",
  "version": "0.2.2",
  "productName": "Golau",
  "description": "Azure DevOps focus companion: keeps you on task and your cards updated",
  "license": "GPL-3.0-or-later",
  "author": "shatteredeagle",
  "repository": {
    "type": "git",
    "url": "https://github.com/shatteredeagle/golau.git"
  },
  "private": true,
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build && node scripts/notices.mjs",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "mock": "node mock/ado-mock.mjs",
    "test": "tsx --test test/scheduler.test.mts test/security.test.mts test/migrate.test.mts test/fields.test.mts",
    "shots": "npm run build && GOLAU_DATA=.shots/data GOLAU_SHOTS=.shots electron .",
    "dist:win": "npm run build && electron-builder --win nsis --x64",
    "dist:linux": "npm run build && electron-builder --linux dir"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "dompurify": "^3.4.17",
    "electron": "^44.9.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^6.0.0",
    "lucide-react": "^1.60.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  }
}
